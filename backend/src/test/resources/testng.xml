<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<!-- Chạy toàn bộ hai module cùng lúc (mvn test, không cần -P). Dùng để tự
     kiểm tra trước buổi thuyết trình; mỗi người thuyết trình chạy riêng
     bằng testng-module1-pricing.xml / testng-module2-booking.xml. -->
<suite name="Arena3-TestSuite" verbose="1">
    <listeners>
        <listener class-name="com.arena3.testsupport.ConsoleNarrator" />
    </listeners>
    <test name="Business-Rules-Tests">
        <classes>
            <class name="com.arena3.service.PricingServiceTest" />
            <class name="com.arena3.service.CourtBookingServiceTest" />
        </classes>
    </test>
</suite>
